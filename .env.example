# Copy this file to .env and fill in the company's keys. Never commit .env.

# --- Required: Google Gemini (get a key at https://aistudio.google.com/apikey) ---
# Enable billing on the Google Cloud project behind this key to remove free-tier limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Live Google Search grounding (true = more accurate, current results)
GEMINI_SEARCH_GROUNDING=true
# Optional backup model used automatically when the main model is busy (pick one from AI Studio)
GEMINI_FALLBACK_MODEL=

# --- Optional: DataForSEO (real search volume, difficulty, top-10 results, People Also Ask) ---
# Sign up at https://dataforseo.com — use the API login and API password from the dashboard.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Security & limits ---
# If set, users must enter this token in the app to generate briefs.
APP_ACCESS_TOKEN=
# Max briefs per user IP per minute
RATE_LIMIT_PER_MIN=20
# How long to reuse a brief for the same keyword + market (0 = no cache)
CACHE_HOURS=72

PORT=3000
# true = sample data, no API calls (for demos/testing)
MOCK_MODE=false
